events {}

http {
    upstream back_info_pool {
        least_conn;

        {{/* consul-template's `service` function queries Consul and, by
             default, returns only instances currently passing their health
             check — the exact list this upstream block should contain.
             Every time that list changes (a backend registers,
             deregisters, or fails its check), this whole file is
             re-rendered and nginx is told to reload. */}}
        {{ range service "back_info" }}
        server {{ .Address }}:{{ .Port }} max_fails=3 fail_timeout=30s;
        {{ else }}
        # No healthy "backend" instances registered in Consul right now.
        # This placeholder keeps the upstream block syntactically valid
        # (nginx requires at least one server) instead of crashing nginx.
        server 127.0.0.1:65535 down;
        {{ end }}
    }

    upstream back_satelite_pool {
        least_conn;

        {{ range service "back_satelite" }}
        server {{ .Address }}:{{ .Port }} max_fails=3 fail_timeout=30s;
        {{ else }}
        
        server 127.0.0.1:65535 down;
        {{ end }}
    }

    upstream back_rocket_pool {
        least_conn;

        {{ range service "back_rocket" }}
        server {{ .Address }}:{{ .Port }} max_fails=3 fail_timeout=30s;
        {{ else }}
        
        server 127.0.0.1:65535 down;
        {{ end }}
    }


    server {
        listen 8000;
        # CORS para el frontend
        add_header Access-Control-Allow-Origin "http://localhost:5173" always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept, Origin, X-Requested-With" always;

        location /satelite {
            proxy_pass http://back_satelite_pool;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /rocket {
            proxy_pass http://back_rocket_pool;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /hyper-satelite {
            proxy_pass http://back_satelite_pool;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /hyper-rocket {
            proxy_pass http://back_rocket_pool;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /tenant {
            proxy_pass http://back_info_pool;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
        
        location /take-off {
            proxy_pass http://back_info_pool;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /energy-transaction {
            proxy_pass http://back_info_pool;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /destination {
            proxy_pass http://back_info_pool;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /heartbeat {
            add_header Content-Type text/plain;
            return 200 "nginx gateway alive";
        }
    }
}